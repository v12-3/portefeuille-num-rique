rules_version = '2';

// Chaque utilisateur lit et écrit uniquement ses propres données
// (users/{uid}/...). La valorisation est calculée dans le navigateur
// (pas de Cloud Function, pour rester sur le forfait gratuit Firebase),
// donc le client écrit directement son portefeuille et son historique —
// mais jamais ceux d'un autre compte.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
