rules_version = '2';

/*
 * Chaque utilisateur lit et écrit uniquement ses propres données
 * (users/{uid}/...). La valorisation est calculée dans le navigateur (pas de
 * Cloud Function, pour rester sur le forfait gratuit), donc le client écrit
 * directement son portefeuille — mais jamais celui d'un autre compte.
 *
 * Les règles vérifient aussi la forme et la taille des documents : un client
 * compromis ou modifié ne doit pas pouvoir remplir la base (le quota gratuit
 * est partagé par tout le projet) ni stocker des données arbitraires.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ~1 Mo est la limite Firestore par document ; on reste bien en dessous
    // pour un portefeuille personnel (quelques centaines de lignes).
    function reasonableSize() {
      return request.resource.size() < 900000;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;                       // rien ne s'écrit à la racine

      // portefeuille, réglages, cache de symboles
      match /portfolio/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
                     && docId in ['main', 'settings', 'symbolCache']
                     && reasonableSize();
      }

      // un point d'historique par jour, identifié par sa date
      match /history/{day} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
                     && day.matches('^\\d{4}-\\d{2}-\\d{2}$')
                     && reasonableSize();
      }

      // tout autre chemin sous users/{uid} est refusé
      match /{other=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
