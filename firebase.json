{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/m/sw.js",
        "headers": [
          { "key": "Service-Worker-Allowed", "value": "/m/" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "comment": "Sans ça, Firebase Hosting sert max-age=3600 : après un déploiement, les navigateurs gardent l'ancien code jusqu'à une heure. no-cache force la revalidation (304 si rien n'a changé, donc pas plus lourd).",
        "source": "**/*.@(html|js|json|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
